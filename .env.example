# MongoDB connection string (MongoDB Atlas free tier works)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/cafe?retryWrites=true&w=majority

# Random long string for JWT signing
JWT_SECRET=change-this-to-a-long-random-string

# Admin login password (you'll use this to log into /admin/login)
ADMIN_PASSWORD=your-strong-admin-password

# Razorpay keys (get from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Public base URL of your deployed site (used to build QR codes)
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app
